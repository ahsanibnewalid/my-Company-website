# Development only: use long, distinct random values in your local .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-high-entropy-secret
JWT_SIGNING_KEY=replace-with-distinct-high-entropy-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In DEBUG=true, DATABASE_URL may be omitted to use local SQLite.
# Production requires PostgreSQL and a durable database URL.
# DATABASE_URL=postgresql://user:password@host:5432/axiom
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
SECURE_SSL_REDIRECT=false
